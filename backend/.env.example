# 本地开发配置。复制为 backend/.env 后按需修改。
# 生产环境不使用 .env 文件，全部由部署平台注入环境变量（05 文档 §5）。

IRP_ENVIRONMENT=local
IRP_LOG_LEVEL=INFO
IRP_LOG_FORMAT=console

# 端口与 deploy/docker-compose.dev.yml 的宿主机映射保持一致
# 应用角色：非超级用户，受 RLS 约束
IRP_DATABASE_URL=postgresql+asyncpg://irp_app:irp_app@127.0.0.1:5433/irp
# 迁移角色：表属主，拥有 DDL 权限
IRP_DATABASE_MIGRATION_URL=postgresql+asyncpg://irp:irp@127.0.0.1:5433/irp
IRP_REDIS_URL=redis://127.0.0.1:6380/0

IRP_S3_ENDPOINT=http://localhost:9000
IRP_S3_BUCKET=irp-documents
IRP_S3_ACCESS_KEY=minioadmin
IRP_S3_SECRET_KEY=minioadmin

# 仅本地可用的弱密钥；非 local 环境启动时会被配置校验拒绝
IRP_JWT_SECRET=dev-only-change-me-0123456789abcdef
# 接入点凭证加密密钥；local 可省略（回退 JWT_SECRET）
# IRP_CREDENTIAL_SECRET=

# --- 模型（默认 fake；真实联调见下）---
IRP_LLM_PROVIDER=fake
IRP_EMBEDDING_PROVIDER=fake
# IRP_RERANK_PROVIDER=fake
IRP_EMBEDDING_DIM=1024
IRP_EMBEDDING_BATCH_SIZE=10

# DeepSeek 聊天示例
# IRP_LLM_PROVIDER=openai_compatible
# IRP_LLM_BASE_URL=https://api.deepseek.com/v1
# IRP_LLM_API_KEY=sk-xxx
# IRP_LLM_MODEL=deepseek-v4-flash-flash
# （官方可用名：deepseek-v4-flash / deepseek-v4-pro，无裸名 deepseek-v4）

# DashScope Embedding / Rerank 示例（与 LLM 凭证分离）
# IRP_EMBEDDING_PROVIDER=openai_compatible
# IRP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IRP_EMBEDDING_API_KEY=sk-xxx
# IRP_EMBEDDING_MODEL=text-embedding-v4
# IRP_RERANK_PROVIDER=openai_compatible
# IRP_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# （注意：rerank 用 compatible-api，embedding 用 compatible-mode）
# IRP_RERANK_API_KEY=sk-xxx
# IRP_RERANK_MODEL=qwen3-rerank
# IRP_RERANK_PATH=/reranks
# 真实 Embedding 时默认开启重排；可显式覆盖：
# IRP_RETRIEVAL_RERANK_DEFAULT=true
